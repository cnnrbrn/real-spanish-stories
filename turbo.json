{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "DATABASE_URL", "VITE_API_URL", "VITE_UMAMI_WEBSITE_ID"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "debug": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true,
      "inputs": ["src/**/*.ts", "src/**/*.spec.ts", "vitest.config.ts"],
      "outputs": ["coverage/**"]
    }
  }
}
