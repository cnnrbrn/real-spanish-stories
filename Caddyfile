# REFERENCE COPY ONLY — not deployed.
# The live config is hand-edited at /etc/caddy/Caddyfile on the VPS.
# Changes here have no effect; SSH in and edit the server directly,
# then run: sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#           sudo systemctl reload caddy

www.realspanishstories.com {
    redir https://realspanishstories.com{uri} permanent
}

realspanishstories.com {
    # 301s: "Just Starting" level renamed to "Absolute Beginner" (slug change)
    # Level listing page
    redir /stories/just-starting-spanish-stories /stories/absolute-beginner-spanish-stories permanent
    # Individual story slugs (the 4 existing "just starting" stories)
    redir /story/maradonas-hand-of-god-just-starting-spanish /story/maradonas-hand-of-god-absolute-beginner-spanish permanent
    redir /story/the-paraguayan-war-just-starting-spanish /story/the-paraguayan-war-absolute-beginner-spanish permanent
    redir /story/the-mountain-that-eats-men-just-starting-spanish /story/the-mountain-that-eats-men-absolute-beginner-spanish permanent
    redir /story/the-cybersyn-project-just-starting-spanish /story/the-cybersyn-project-absolute-beginner-spanish permanent

    # 301: "Series" browse page moved to "Stories"
    redir /series /stories permanent

    handle /api/* {
        reverse_proxy localhost:3001
    }

    handle {
        reverse_proxy localhost:3000
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/access.log
        format json
    }
}
